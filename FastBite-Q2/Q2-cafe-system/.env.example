# FastBite configuration template.
# Copy to .env and fill in real values:   copy .env.example .env   (Windows)
# .env is git-ignored - real passwords never go into the repository.

# ---- MongoDB (one server, each service uses its own database) ----
MONGO_HOST=mongodb:27017
MONGO_USER=fastbite_app
MONGO_PASSWORD=change-me
MONGO_AUTH_SOURCE=admin

# ---- Service discovery (hostnames, not localhost) ----
# PM2 on one machine: the hostnames are mapped in the Windows hosts file (scripts/add-hosts.ps1).
# Docker Compose: the hostnames are the compose service names (built-in Docker DNS).
MENU_SERVICE_URL=http://menu-service:3001
ORDER_SERVICE_URL=http://order-service:3002
INVENTORY_SERVICE_URL=http://inventory-service:3003
CUSTOMER_SERVICE_URL=http://customer-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005

# Insert demo data (menu, stock, Hamza & Ayesha) on first start
SEED_DATA=true
